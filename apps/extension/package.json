{
  "name": "@app/extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Autofill from Apple Passwords in Chromium browsers and Firefox",
  "scripts": {
    "dev": "wxt",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:all": "bun run build:chrome && bun run build:firefox",
    "zip:all": "wxt zip && wxt zip -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test:e2e": "bun run build:chrome && playwright test",
    "capture:store": "bun run build:chrome && playwright test --config media.config.ts",
    "postinstall": "wxt prepare",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv2 --warnings-as-errors"
  },
  "dependencies": {
    "@app/protocol": "workspace:*"
  },
  "devDependencies": {
    "@app/fake-helper": "workspace:*",
    "@playwright/test": "^1.64.0",
    "happy-dom": "^21.0.4",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
