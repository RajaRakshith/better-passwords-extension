{
  "name": "@app/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Autofill from Apple Passwords in Chromium browsers and Firefox",
  "scripts": {
    "dev": "VARIANT=store wxt",
    "dev:github": "VARIANT=github wxt",
    "build:store": "VARIANT=store wxt build",
    "build:github": "VARIANT=github wxt build",
    "build:firefox": "VARIANT=store wxt build -b firefox",
    "build:all": "bun run build:store && bun run build:github && bun run build:firefox",
    "zip:all": "VARIANT=store wxt zip && VARIANT=github wxt zip && VARIANT=store wxt zip -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test:e2e": "bun run build:store && playwright test",
    "postinstall": "wxt prepare",
    "lint:firefox": "web-ext lint --source-dir .output/store-firefox-mv2 --warnings-as-errors"
  },
  "dependencies": {
    "@app/protocol": "workspace:*"
  },
  "devDependencies": {
    "@app/fake-helper": "workspace:*",
    "@playwright/test": "^1.64.0",
    "happy-dom": "^21.0.1",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
