<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened runtime blocks Contacts unless the app declares it: the agent reads the user's
     own contact card to suggest their emails on sign-up forms. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
</dict>
</plist>
