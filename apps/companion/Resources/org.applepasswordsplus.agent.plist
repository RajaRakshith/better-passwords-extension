<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Registered by the app with SMAppService. launchd starts the agent only when the native host
     connects to its XPC service, and the agent quits again after a quiet minute. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.applepasswordsplus.agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/ApplePasswordsPlus</string>
	<key>ProgramArguments</key>
	<array>
		<string>ApplePasswordsPlus</string>
		<string>--agent</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>org.applepasswordsplus.agent</key>
		<true/>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>org.applepasswordsplus.companion</string>
	</array>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
